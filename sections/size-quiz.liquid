        {
          "value": "ruler",
          "label": "Ruler"
        },
        {
          "value": "ruler_diagonal",
          "label": "Ruler (diagonal)"
        },
        {
          "value": "tape",
          "label": "Tape measure"
        },
        {
          "value": "grid",
          "label": "Size chart grid"
        },
        {
          "value": "person",
          "label": "Body"
        },
        {
