{% comment %}
  ===========================================================================
  SIZE QUIZ - standalone section
  ===========================================================================
  Self-contained: one file, depends on nothing else, overwrites nothing.
  Add it to any template from the theme editor.

  On a product template it reads that product's sizes. On any other page,
  type the sizes into the Sizes field.
  ===========================================================================
{% endcomment %}

{%- liquid
  assign sq_uid = section.id
  assign sq_size_name = 'Size'
  assign sq_has_sizes = false

  for option in product.options_with_values
    assign name_dc = option.name | downcase
    if name_dc contains 'size'
      assign sq_size_option = option
      assign sq_size_name = option.name
      assign sq_has_sizes = true
    endif
  endfor

  unless sq_has_sizes
    for option in product.options_with_values
      unless sq_has_sizes
        if option.values.size > 1
          assign sq_size_option = option
          assign sq_size_name = option.name
          assign sq_has_sizes = true
        endif
      endunless
    endfor
  endunless

  assign sq_has_product = sq_has_sizes

  if sq_has_sizes
    assign sq_sizes = sq_size_option.values
  else
    assign sq_raw = section.settings.sizes | default: ''
    if sq_raw != blank
      assign sq_clean = ''
      assign sq_parts = sq_raw | split: ','
      for v in sq_parts
        assign trimmed = v | strip
        if trimmed != blank
          if sq_clean == ''
            assign sq_clean = trimmed
          else
            assign sq_clean = sq_clean | append: '|~|' | append: trimmed
          endif
        endif
      endfor
      if sq_clean != ''
        assign sq_sizes = sq_clean | split: '|~|'
        assign sq_has_sizes = true
      endif
    endif
  endif

  assign sq_accent = section.settings.accent_color | default: '#1B2340'
  assign sq_accent_text = section.settings.accent_text_color | default: '#FFFFFF'
  assign sq_surface = section.settings.surface_color | default: '#FFF4F9'
  assign sq_pink = section.settings.pink_color | default: '#FFADD6'
  assign sq_bg = section.settings.background_color | default: '#f2efec'
  assign sq_radius = section.settings.corner_radius | default: 10
  assign sq_align = section.settings.alignment | default: 'left'
  assign icon = section.settings.icon

  assign sq_link_col = section.settings.link_color
  if sq_link_col == blank or sq_link_col == 'rgba(0,0,0,0)'
    assign sq_link_col = 'inherit'
  endif

  assign sq_border = section.settings.border_color
  if sq_border == blank or sq_border == 'rgba(0,0,0,0)'
    assign sq_border = 'rgba(0,0,0,0.08)'
  endif
-%}

{%- capture sq_icon -%}
{%- case icon -%}
  {%- when 'ruler' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="7.5" width="21" height="9" rx="1.5"/><path d="M6 7.5v3M10 7.5v4.5M14 7.5v3M18 7.5v4.5"/></svg>
  {%- when 'ruler_diagonal' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="-1" y="8" width="26" height="8" rx="1.5" transform="rotate(-45 12 12)"/><path d="M8.4 8.4l1.8 1.8M11.2 5.6l2.6 2.6M14 2.8l1.8 1.8"/></svg>
  {%- when 'tape' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 0 0-9 9v6.5A2.5 2.5 0 0 0 5.5 21h13a2.5 2.5 0 0 0 2.5-2.5V12a9 9 0 0 0-9-9Z"/><circle cx="12" cy="12" r="3"/><path d="M7 21v-2M12 21v-3M17 21v-2"/></svg>
  {%- when 'person' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4.5" r="2.25"/><path d="M12 6.75v6.5M12 13.25 8.5 21M12 13.25 15.5 21M7.5 9h9"/></svg>
  {%- when 'question' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.25"/><path d="M9.5 9.2a2.6 2.6 0 1 1 3.4 2.5c-.6.2-.9.8-.9 1.4v.5"/><path d="M12 16.9v.01"/></svg>
  {%- when 'sparkle' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.75 14 9l6.25 2-6.25 2L12 19.25 10 13l-6.25-2L10 9Z"/><path d="M19 3v3M20.5 4.5h-3"/></svg>
  {%- when 'grid' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1.5"/><path d="M3 9.5h18M3 15.5h18M9.5 3v18"/></svg>
  {%- when 'arrow' -%}
    <svg class="ffl__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 7l5 5-5 5"/></svg>
{%- endcase -%}
{%- endcapture -%}

{%- if sq_has_sizes == false and request.design_mode -%}
  <div style="margin:12px 0;padding:12px 14px;border:1px dashed #b1472d;border-radius:4px;font-size:13px;line-height:1.5;color:#b1472d;">
    <strong>Size quiz &mdash; only you can see this.</strong>
    No sizes found. On a page with no product, type the sizes into the Sizes field.
  </div>
{%- endif -%}

{%- if sq_has_sizes -%}
<div class="sq-wrap">
  {%- if section.settings.appearance == 'banner' -%}
    <button type="button" class="sq-trigger sq-trigger--banner" data-ff-open>
      {{ sq_icon }}
      <span class="sq-banner__text">
        <span class="sq-banner__heading">{{ section.settings.heading }}</span>
        {%- if section.settings.subtext != blank -%}
          <span class="sq-banner__sub">{{ section.settings.subtext }}</span>
        {%- endif -%}
      </span>
      <span class="sq-banner__cta">{{ section.settings.button_label }}</span>
    </button>
  {%- else -%}
    <button type="button" class="sq-trigger sq-trigger--link" data-ff-open>
      {{ sq_icon }}
      <span>{{ section.settings.label }}</span>
    </button>
  {%- endif -%}
</div>

<div
  class="ff-overlay"
  id="FitFinder-{{ sq_uid }}"
  data-ff-modal
  data-ff-scope="MainProduct-{{ sq_uid }}"
  hidden
  style="--ff-accent: {{ sq_accent }}; --ff-accent-text: {{ sq_accent_text }}; --ff-surface: {{ sq_surface }}; --ff-pink: {{ sq_pink }}; --ff-radius: {{ sq_radius }}px;">

  <div class="ff-sheet" role="dialog" aria-modal="true" aria-labelledby="FitFinderTitle-{{ sq_uid }}">
    <div class="ff-head">
      <div class="ff-head__text">
        <p class="ff-head__title" id="FitFinderTitle-{{ sq_uid }}">{{ section.settings.modal_title }}</p>
        <p class="ff-head__sub"></p>
      </div>
      <button type="button" class="ff-close" data-ff-close aria-label="Close">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    </div>
    <div class="ff-progress" role="presentation"><span class="ff-progress__bar" data-ff-bar></span></div>
    <div class="ff-body" data-ff-body tabindex="-1"></div>
    <div class="ff-foot">
      <button type="button" class="ff-link" data-ff-back hidden>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6l-6 6 6 6"/></svg>
        Back
      </button>
      <p class="ff-step" data-ff-step aria-live="polite"></p>
    </div>
  </div>
</div>

<style>

  /* ---------------------------------------------------------------- shell */
  .ff-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(27, 35, 64, 0.55);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .ff-overlay[hidden] { display: none; }
  .ff-overlay.is-open { opacity: 1; }

  .ff-sheet {
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 480px;
    max-height: 88vh;
    background: #fff;
    color: var(--ff-accent);
    border-radius: var(--ff-radius);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(27, 35, 64, 0.28);
    transform: translateY(14px) scale(0.985);
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .ff-overlay.is-open .ff-sheet { transform: none; }

  /* --------------------------------------------------------------- header */
  .ff-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    background: var(--ff-accent);
    color: var(--ff-accent-text);
  }
  .ff-head__title {
    margin: 0;
    font-family: Anton, sans-serif;
    font-size: 19px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .ff-head__sub {
    margin: 5px 0 0;
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: var(--ff-pink);
  }
  .ff-close {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin: -4px -8px 0 0;
    padding: 0;
    background: none;
    border: none;
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .ff-close:hover { background: rgba(255, 255, 255, 0.14); }
  .ff-close:focus-visible { outline: 2px solid var(--ff-pink); outline-offset: 2px; }

  .ff-progress { height: 3px; background: var(--ff-surface); }
  .ff-progress__bar {
    display: block;
    height: 100%;
    width: 0;
    background: var(--ff-pink);
    transition: width 0.3s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  /* ----------------------------------------------------------- questions */
  .ff-body {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 26px 24px;
  }
  .ff-body:focus { outline: none; }

  .ff-q { margin: 0; padding: 0; border: none; }
  .ff-q__legend {
    display: block;
    margin: 0 0 6px;
    padding: 0;
    font-family: Anton, sans-serif;
    font-size: 20px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.25;
    color: var(--ff-accent);
  }
  .ff-q__help {
    margin: 0 0 20px;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
    opacity: 0.55;
  }

  .ff-options { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .ff-options--grid { grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; }

  .ff-opt { display: block; margin: 0; }
  .ff-opt input {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    clip: rect(0 0 0 0);
    overflow: hidden;
  }
  .ff-opt__box {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 44px 15px 16px;
    border: 1.5px solid rgba(27, 35, 64, 0.14);
    border-radius: calc(var(--ff-radius) - 2px);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .ff-opt__box::after {
    content: "";
    position: absolute;
    right: 15px;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border: 1.5px solid rgba(27, 35, 64, 0.25);
    border-radius: 50%;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .ff-opt__box:hover { border-color: var(--ff-pink); background: var(--ff-surface); }
  .ff-opt input:focus-visible + .ff-opt__box {
    outline: 2px solid var(--ff-accent);
    outline-offset: 2px;
  }
  .ff-opt input:checked + .ff-opt__box {
    border-color: var(--ff-accent);
    background: var(--ff-surface);
  }
  .ff-opt input:checked + .ff-opt__box::after {
    border-color: var(--ff-accent);
    background: var(--ff-accent);
    box-shadow: inset 0 0 0 3px #fff;
  }

  /* Size tiles read as chips rather than rows. */
  .ff-options--grid .ff-opt__box {
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 52px;
    padding: 8px 4px;
    font-weight: 700;
    letter-spacing: normal;
    white-space: nowrap;
  }
  .ff-options--grid .ff-opt__label { font-size: 14px; }
  .ff-options--grid .ff-opt__box::after { display: none; }
  .ff-options--grid .ff-opt input:checked + .ff-opt__box {
    background: var(--ff-accent);
    color: #fff;
  }

  .ff-opt__label { display: block; font-size: 15.5px; line-height: 1.3; letter-spacing: normal; }
  .ff-opt__sub { display: block; font-size: 12.5px; line-height: 1.35; opacity: 0.6; margin-top: 3px; letter-spacing: normal; }

  /* -------------------------------------------------------------- buttons */
  .ff-fields { display: grid; gap: 12px; }
  .ff-field { display: flex; align-items: center; gap: 14px; }
  .ff-field__label {
    flex: 0 0 68px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ff-accent);
  }
  .ff-field__input {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    align-items: center;
  }
  .ff-field__input input {
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 13px 46px 13px 14px;
    font-family: inherit;
    font-size: 16px;
    color: var(--ff-accent);
    background: #fff;
    border: 1.5px solid rgba(27, 35, 64, 0.14);
    border-radius: calc(var(--ff-radius) - 2px);
    -moz-appearance: textfield;
  }
  .ff-field__input input::-webkit-outer-spin-button,
  .ff-field__input input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .ff-field__input input:hover { border-color: var(--ff-pink); }
  .ff-field__input input:focus {
    outline: none;
    border-color: var(--ff-accent);
    background: var(--ff-surface);
  }
  .ff-field__unit {
    position: absolute;
    right: 14px;
    font-size: 13px;
    opacity: 0.5;
    pointer-events: none;
  }
  .ff-q__note {
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 1.45;
    opacity: 0.55;
  }

  .ff-btn {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 24px 0 0;
    padding: 15px 16px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid var(--ff-accent);
    border-radius: calc(var(--ff-radius) - 2px);
    background: var(--ff-accent);
    color: var(--ff-accent-text);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, opacity 0.15s ease;
  }
  .ff-btn:hover { background: #2a3459; }
  .ff-btn:focus-visible { outline: 2px solid var(--ff-pink); outline-offset: 2px; }
  .ff-btn[disabled] { opacity: 0.25; cursor: default; background: var(--ff-accent); }
  .ff-btn--ghost {
    background: transparent;
    color: var(--ff-accent);
    border-color: rgba(27, 35, 64, 0.25);
  }
  .ff-btn--ghost:hover { background: var(--ff-surface); border-color: var(--ff-pink); color: var(--ff-accent); }

  .ff-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 24px;
    border-top: 1px solid rgba(27, 35, 64, 0.08);
  }
  .ff-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 0;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 13px;
    color: var(--ff-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .ff-link:hover { opacity: 0.6; }
  .ff-link[hidden] { display: none; }
  .ff-step {
    margin: 0 0 0 auto;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  /* --------------------------------------------------------------- result */
  .ff-result { text-align: center; padding: 4px 0 0; }
  .ff-result__eyebrow {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .ff-result__size {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    height: 140px;
    margin: 0 0 18px;
    padding: 0 10px;
    box-sizing: border-box;
    font-family: Anton, sans-serif;
    font-size: 32px;
    line-height: 1;
    letter-spacing: 0.01em;
    text-align: center;
    color: var(--ff-accent);
    border-radius: 50%;
    background: var(--ff-surface);
    border: 2px solid var(--ff-pink);
  }
  .ff-result__size--long { font-size: 24px; }
  .ff-result__note {
    margin: 0 auto;
    max-width: 19em;
    font-size: 14.5px;
    line-height: 1.6;
    text-wrap: balance;
    opacity: 0.75;
  }
  .ff-result__reassure {
    margin: 14px auto 0;
    max-width: 22em;
    padding-top: 14px;
    border-top: 1px solid rgba(27, 35, 64, 0.1);
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 1.5;
    color: var(--ff-accent);
    opacity: 0.7;
  }
  .ff-result__actions { margin-top: 24px; }
  .ff-result__actions .ff-btn + .ff-btn { margin-top: 10px; }

  /* --------------------------------------------------------------- mobile */
  @media screen and (max-width: 600px) {
    .ff-overlay { align-items: flex-end; padding: 0; }
    .ff-sheet {
      max-width: none;
      max-height: 92vh;
      border-radius: 16px 16px 0 0;
      transform: translateY(100%);
    }
    .ff-head { padding: 18px 18px; }
    .ff-head__title { font-size: 17px; }
    .ff-body { padding: 22px 18px; }
    .ff-q__legend { font-size: 19px; }
    .ff-foot { padding: 12px 18px calc(12px + env(safe-area-inset-bottom)); }
    .ff-result__size { width: 124px; height: 124px; font-size: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ff-overlay, .ff-sheet, .ff-progress__bar, .ff-btn, .ff-opt__box { transition: none; }
  }

  .sq-wrap { margin: {{ section.settings.space_above }}px 0 {{ section.settings.space_below }}px; text-align: {{ sq_align }}; }
  .sq-trigger .ffl__icon { flex: 0 0 auto; width: 1.15em; height: 1.15em; }

  .sq-trigger--link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 2px 0;
    background: none;
    border: none;
    font-family: inherit;
    font-size: {{ section.settings.font_size }}px;
    color: {{ sq_link_col }};
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .sq-trigger--link:hover { opacity: 0.65; }
  .sq-trigger--link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .sq-trigger--banner {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 14px 16px;
    text-align: left;
    font-family: inherit;
    color: {{ sq_link_col }};
    background: {{ sq_bg }};
    border: 1px solid {{ sq_border }};
    border-radius: {{ sq_radius }}px;
    cursor: pointer;
  }
  .sq-trigger--banner:hover { border-color: {{ sq_accent }}; }
  .sq-trigger--banner:focus-visible { outline: 2px solid {{ sq_accent }}; outline-offset: 2px; }
  .sq-trigger--banner .ffl__icon { width: 26px; height: 26px; color: {{ sq_accent }}; }
  .sq-banner__text { flex: 1 1 auto; min-width: 0; }
  .sq-banner__heading { display: block; font-size: 14px; font-weight: 700; line-height: 1.25; }
  .sq-banner__sub { display: block; margin-top: 2px; font-size: 12.5px; line-height: 1.35; opacity: 0.65; }
  .sq-banner__cta {
    flex: 0 0 auto;
    padding: 9px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: {{ sq_radius }}px;
    background: {{ sq_accent }};
    color: {{ sq_accent_text }};
  }
  @media screen and (max-width: 600px) {
    .sq-trigger--banner { flex-wrap: wrap; }
    .sq-banner__cta { width: 100%; text-align: center; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('FitFinder-{{ sq_uid }}');
  if (!root || root.dataset.ffReady) return;
  root.dataset.ffReady = '1';

  /* ---------------------------------------------------------------------
     QUIZ QUESTIONS — edit here and nowhere else.
     type 'sizes'  = options are built from this product's size options.
     offset        = how many sizes to move from the customer's usual size.
     --------------------------------------------------------------------- */
  var QUESTIONS = [
    {
      id: 'usual',
      type: 'sizes',
      legend: 'What size do you usually wear?',
      help: 'Go with whatever you reach for most often.'
    },
    {
      id: 'feel',
      legend: 'How do you like things to feel?',
      help: 'There is no wrong answer here.',
      options: [
        { label: 'Snug and supportive', sub: 'Close to the body', offset: -1 },
        { label: 'True to size',        sub: 'Fitted, not tight', offset: 0 },
        { label: 'Relaxed',             sub: 'Room to move',      offset: 1 }
      ]
    },
    {
      id: 'shape',
      legend: 'Where do you usually need a little more room?',
      options: [
        { label: 'Bust or chest',   offset: 1 },
        { label: 'Hips and thighs', offset: 1 },
        { label: 'Waist or tummy',  offset: 1 },
        { label: 'Pretty even all over', offset: 0 },
        { label: 'I normally size down', offset: -1 }
      ]
    }
  ];


  /* Set in the theme editor under Measurements. */
  var MEASURE_RAW = {{ section.settings.measurements | default: '' | json }};
  var HALF_GARMENT = {{ section.settings.half_measurements | json }};
  var ALLOWANCE_RAW = {{ section.settings.allowance | default: '' | json }};
  var STRETCH_USE = {{ section.settings.stretch_use | default: 50 | json }};
  var HAS_PRODUCT = {{ sq_has_product | json }};
  var READ_AS = {{ section.settings.read_as | default: 'ladder' | json }};
  var SIZE_OFFSET = {{ section.settings.size_offset | default: 0 | json }};
  var SIZES      = {{ sq_sizes | json }};
  var SIZE_LABEL = {{ sq_size_name | json }};
  var SCOPE_ID   = root.getAttribute('data-ff-scope');
  var STORE_KEY  = 'ff:{{ product.id }}';

  var sheet   = root.querySelector('.ff-sheet');
  var body    = root.querySelector('[data-ff-body]');
  var bar     = root.querySelector('[data-ff-bar]');
  var stepEl  = root.querySelector('[data-ff-step]');
  var backBtn = root.querySelector('[data-ff-back]');

  /* Parse lines like:  XXS (6): bust 78-82, waist 60-64, hip 86-90
     Forgiving on order, separators and wording. */
  var MEASURE = (function () {
    var out = {}, any = false;
    String(MEASURE_RAW || '').split(/\r?\n/).forEach(function (line) {
      var split = line.indexOf(':');
      if (split < 0) return;
      var name = line.slice(0, split).trim();
      if (!name) return;
      var body = line.slice(split + 1);
      var row = {};

      /* Labelled form: "bust 78-82, waist 60-64, hip 86-90" */
      var re = /(bust|chest|waist|hip|hips)\s*:?\s*(\d+(?:\.\d+)?)\s*(?:-|\u2013|\u2014|to)+\s*(\d+(?:\.\d+)?)/gi;
      var m;
      while ((m = re.exec(body))) {
        var key = m[1].toLowerCase();
        if (key === 'chest') key = 'bust';
        if (key === 'hips') key = 'hip';
        row[key] = [parseFloat(String(m[2]).replace(',', '.')), parseFloat(String(m[3]).replace(',', '.'))];
      }

      /* Single-value form: "waist 32.25, hip 55.3" from a garment spec sheet.
         Runs regardless of whether a range was found, so a line can mix the
         two - a waist range alongside a single hip number, for instance.
         Commas are accepted as decimal points, as spec sheets often use them. */
      var one = /(bust|chest|waist|hip|hips)\s*:?\s*(\d+(?:[.,]\d+)?)(?!\s*(?:-|\u2013|\u2014|to)\s*\d)/gi;
      var o;
      while ((o = one.exec(body))) {
        var k1 = o[1].toLowerCase();
        if (k1 === 'chest') k1 = 'bust';
        if (k1 === 'hips') k1 = 'hip';
        if (row[k1] === undefined) row[k1] = parseFloat(String(o[2]).replace(',', '.'));
      }

      /* Unlabelled form: "78-82, 60-64, 86-90" taken as bust, waist, hip. */
      if (!Object.keys(row).length) {
        var order = ['bust', 'waist', 'hip'];
        var bare = /(\d+(?:\.\d+)?)\s*(?:-|\u2013|\u2014|to)+\s*(\d+(?:\.\d+)?)/g;
        var i = 0, b;
        while ((b = bare.exec(body)) && i < order.length) {
          row[order[i++]] = [parseFloat(b[1]), parseFloat(b[2])];
        }
      }
      if (Object.keys(row).length) { out[name.toLowerCase()] = row; any = true; }
    });
    return any ? out : null;
  })();

  /* Fit allowance, e.g. "waist 10, hip 6". Positive means the wearer's body
     can be this much bigger than the garment. */
  var ALLOWANCE = (function () {
    var out = {};
    var re = /(bust|chest|waist|hip|hips)\s*:?\s*(-?\d+(?:[.,]\d+)?)\s*(%?)/gi;
    var m;
    while ((m = re.exec(String(ALLOWANCE_RAW || '')))) {
      var k = m[1].toLowerCase();
      if (k === 'chest') k = 'bust';
      if (k === 'hips') k = 'hip';
      out[k] = { value: parseFloat(String(m[2]).replace(',', '.')), pct: m[3] === '%' };
    }
    return out;
  })();

  /* A single garment number becomes the biggest body measurement it fits
     comfortably: doubled if the sheet lists half measurements, then either a
     flat allowance in cm, or a share of how far the elastic stretches. */
  function toBody(value, field) {
    /* A range in garment mode is unstretched to fully stretched. Sitting at
       full stretch is not a comfortable fit, so take part of the way. */
    if (Object.prototype.toString.call(value) === '[object Array]') {
      var lo = HALF_GARMENT ? value[0] * 2 : value[0];
      var hi = HALF_GARMENT ? value[1] * 2 : value[1];
      return lo + (hi - lo) * (STRETCH_USE / 100);
    }
    var v = HALF_GARMENT ? value * 2 : value;
    var a = ALLOWANCE[field];
    if (!a) return v;
    if (!a.pct) return v + a.value;
    return v + (v * a.value / 100) * (STRETCH_USE / 100);
  }

  /* Garment mode: the numbers describe the garment, not the wearer. */
  var GARMENT_MODE = HALF_GARMENT || Object.keys(ALLOWANCE).length > 0;

  var FIELDS = [
    { id: 'bust',  label: 'Bust' },
    { id: 'waist', label: 'Waist' },
    { id: 'hip',   label: 'Hip' }
  ];

  if (MEASURE) {
    QUESTIONS.splice(1, 0, {
      id: 'measure',
      type: 'measure',
      legend: 'Know your measurements?',
      help: 'Optional, but it makes the recommendation far more accurate. Centimetres.'
    });
  }

  /* Line under the recommendation. Edit the wording here. */
  var REASSURANCE = 'Not quite right? We do 30 day exchanges.';

  var subEl = root.querySelector('.ff-head__sub');
  if (subEl) subEl.textContent = QUESTIONS.length + ' x Questions';

  var step = 0;
  var answers = {};
  var lastFocused = null;

  /* Move to <body> so a transformed ancestor can never trap position:fixed. */
  if (root.parentNode !== document.body) document.body.appendChild(root);

  /* ----------------------------- rendering ---------------------------- */

  function optionsFor(q) {
    if (q.type !== 'sizes') return q.options;
    return SIZES.map(function (v, i) { return { label: v, value: v, index: i }; });
  }

  function renderMeasureStep(q) {
    var html = '<fieldset class="ff-q">' +
      '<legend class="ff-q__legend">' + esc(q.legend) + '</legend>' +
      '<p class="ff-q__help">' + esc(q.help) + '</p>' +
      '<div class="ff-fields">';

    FIELDS.forEach(function (f) {
      var val = (answers.measure && answers.measure[f.id]) || '';
      html += '<div class="ff-field">' +
        '<label class="ff-field__label" for="ff-' + f.id + '">' + esc(f.label) + '</label>' +
        '<div class="ff-field__input">' +
          '<input id="ff-' + f.id + '" type="number" inputmode="decimal" min="40" max="200" step="0.5" ' +
            'value="' + esc(val) + '" data-ff-field="' + f.id + '" placeholder="--">' +
          '<span class="ff-field__unit">cm</span>' +
        '</div>' +
      '</div>';
    });

    html += '</div>' +
      '<p class="ff-q__note">Leave blank and we will go on your usual size instead.</p>' +
      '</fieldset>' +
      '<button type="button" class="ff-btn" data-ff-next>Continue</button>';

    body.innerHTML = html;

    body.querySelector('.ff-fields').addEventListener('input', function (e) {
      var f = e.target.getAttribute('data-ff-field');
      if (!f) return;
      answers.measure = answers.measure || {};
      answers.measure[f] = e.target.value;
    });

    body.querySelector('[data-ff-next]').addEventListener('click', function () {
      if (step === QUESTIONS.length - 1) { renderResult(); } else { step++; renderStep(); }
      paint();
    });

    paint();
    var first = body.querySelector('input');
    if (first) first.focus();
  }

  function renderStep() {
    var q = QUESTIONS[step];
    if (q.type === 'measure') { renderMeasureStep(q); return; }
    var opts = optionsFor(q);
    var grid = q.type === 'sizes' ? ' ff-options--grid' : '';
    var name = 'ff-{{ sq_uid }}-' + q.id;

    var html = '<fieldset class="ff-q">' +
      '<legend class="ff-q__legend">' + esc(q.legend) + '</legend>' +
      (q.help ? '<p class="ff-q__help">' + esc(q.help) + '</p>' : '') +
      '<div class="ff-options' + grid + '">';

    opts.forEach(function (o, i) {
      var id = name + '-' + i;
      var checked = answers[q.id] && answers[q.id].label === o.label ? ' checked' : '';
      html += '<div class="ff-opt">' +
        '<input type="radio" id="' + id + '" name="' + name + '" data-ff-index="' + i + '" value="' + esc(o.label) + '"' + checked + '>' +
        '<label class="ff-opt__box" for="' + id + '">' +
          '<span><span class="ff-opt__label">' + esc(o.label) + '</span>' +
          (o.sub ? '<span class="ff-opt__sub">' + esc(o.sub) + '</span>' : '') + '</span>' +
        '</label>' +
      '</div>';
    });

    html += '</div></fieldset>' +
      '<button type="button" class="ff-btn" data-ff-next disabled>' +
      (step === QUESTIONS.length - 1 ? 'See my size' : 'Continue') + '</button>';

    body.innerHTML = html;

    var next = body.querySelector('[data-ff-next]');
    next.disabled = !answers[q.id];

    /* Listener sits on the freshly built options container, so it is thrown
       away with the markup on the next render and can never stack up. */
    body.querySelector('.ff-options').addEventListener('change', function (e) {
      if (e.target.name !== name) return;
      answers[q.id] = opts[Number(e.target.dataset.ffIndex)];
      next.disabled = false;
    });

    next.addEventListener('click', function () {
      if (step === QUESTIONS.length - 1) { renderResult(); } else { step++; renderStep(); }
      paint();
    });

    paint();
    var first = body.querySelector('input');
    if (first) (body.querySelector('input:checked') || first).focus();
  }

  /* Best size by measurement: most fields inside range wins, then closest fit. */
  function sizeFromMeasurements() {
    if (!MEASURE || !answers.measure) return -1;

    var given = {};
    FIELDS.forEach(function (f) {
      var v = parseFloat(answers.measure[f.id]);
      if (!isNaN(v) && v > 0) given[f.id] = v;
    });
    if (!Object.keys(given).length) return -1;

    /* Garment sheets: pick the smallest size that fits each measurement, then
       take the largest of those so nothing ends up too tight. */
    var singles = GARMENT_MODE || SIZES.some(function (label) {
      var row = matchRow(label);
      return row && typeof row[Object.keys(row)[0]] === 'number';
    });

    if (singles) {
      var chosen = -1;
      for (var f in given) {
        var fit = sizeForField(f, given[f]);
        if (fit > chosen) chosen = fit;
      }
      return chosen;
    }

    var best = -1, bestHits = -1, bestMiss = Infinity;

    SIZES.forEach(function (label, i) {
      var row = matchRow(label);
      if (!row) return;

      var hits = 0, miss = 0, used = 0;
      for (var k in given) {
        if (!row[k]) continue;
        used++;
        var lo = row[k][0], hi = row[k][1], v = given[k];
        if (v >= lo && v <= hi) { hits++; }
        else { miss += v < lo ? lo - v : v - hi; }
      }
      if (!used) return;

      if (hits > bestHits || (hits === bestHits && miss < bestMiss)) {
        best = i; bestHits = hits; bestMiss = miss;
      }
    });

    return best;
  }

  /* Accepts "XXS" for a product size of "XXS (6)", and vice versa. */
  function matchRow(label) {
    var key = String(label).trim().toLowerCase();
    if (MEASURE[key]) return MEASURE[key];
    var short = key.replace(/\s*\(.*$/, '').trim();
    if (MEASURE[short]) return MEASURE[short];
    for (var k in MEASURE) {
      if (k.replace(/\s*\(.*$/, '').trim() === short) return MEASURE[k];
    }
    return null;
  }

  /* One measurement, one size.

     Where the size is given as a range, that is the garment relaxed through to
     the elastic fully stretched. Landing inside the range means that size —
     unless they are nearer the stretched end than the relaxed end, in which
     case the next size up is the more comfortable call. STRETCH_USE sets where
     that tipping point sits, 50% being the halfway mark.

     Where the size is a single number, it is the largest body that size fits. */
  function sizeForField(field, value) {
    /* Ladder: each number is where that size STARTS. A size runs from its own
       number up to the next size's, so the sizes never overlap. Derived from a
       garment spec sheet this is the relaxed measurement of each size. */
    if (READ_AS === 'ladder') {
      var best = -1;
      for (var L = 0; L < SIZES.length; L++) {
        var rowL = matchRow(SIZES[L]);
        if (!rowL || rowL[field] === undefined) continue;
        var rawL = rowL[field];
        var startL = Object.prototype.toString.call(rawL) === '[object Array]' ? rawL[0] : rawL;
        if (HALF_GARMENT) startL = startL * 2;
        var aL = ALLOWANCE[field];
        if (aL) startL += aL.pct ? startL * aL.value / 100 : aL.value;
        if (startL <= value) best = L;
        if (best === -1 && L === SIZES.length - 1) best = 0;
      }
      return best === -1 ? 0 : best;
    }

    var last = -1;

    for (var i = 0; i < SIZES.length; i++) {
      var row = matchRow(SIZES[i]);
      if (!row || row[field] === undefined) continue;
      last = i;

      var raw = row[field];
      if (Object.prototype.toString.call(raw) !== '[object Array]') {
        if (toBody(raw, field) >= value) return i;
        continue;
      }

      var lo = HALF_GARMENT ? raw[0] * 2 : raw[0];
      var hi = HALF_GARMENT ? raw[1] * 2 : raw[1];

      if (value < lo) return i;           /* smaller than this size relaxed */
      if (value > hi) continue;           /* past this size fully stretched */

      var through = (hi === lo) ? 0 : (value - lo) / (hi - lo);
      if (through > STRETCH_USE / 100 && i + 1 < SIZES.length) return i + 1;
      return i;
    }

    return last;
  }

  function recommend() {
    var measured = sizeFromMeasurements();
    var base = measured >= 0
      ? measured
      : (answers.usual ? answers.usual.index : Math.floor(SIZES.length / 2));
    var shift = 0;
    QUESTIONS.forEach(function (q) {
      var a = answers[q.id];
      if (a && typeof a.offset === 'number') shift += a.offset;
    });
    /* Two independent nudges in the same direction only move one size. */
    if (shift > 1) shift = 1;
    if (shift < -1) shift = -1;

    /* Flat correction, for when a whole size chart runs consistently small
       or large against how the garments really fit. */
    shift += SIZE_OFFSET;
    var idx = Math.min(SIZES.length - 1, Math.max(0, base + shift));
    return { size: SIZES[idx], moved: idx - base, measured: measured >= 0 };
  }

  function renderResult() {
    var r = recommend();
    var note;
    if (r.measured) {
      note = r.moved === 0
        ? 'This is the closest match to your measurements for this fit.'
        : 'Your measurements sit close to the edge, so we have adjusted for how you like things to fit.';
    } else if (r.moved > 0) {
      note = 'Based on your answers we would size you up from your usual ' + answers.usual.label + '.';
    } else if (r.moved < 0) {
      note = 'Based on your answers we would size you down from your usual ' + answers.usual.label + '.';
    } else {
      note = 'Your usual size looks like the right call for this one.';
    }

    body.innerHTML =
      '<div class="ff-result">' +
        '<p class="ff-result__eyebrow">We recommend</p>' +
        '<p class="ff-result__size' + (String(r.size).length > 6 ? ' ff-result__size--long' : '') + '">' + esc(r.size) + '</p>' +
        '<p class="ff-result__note">' + esc(note) + '</p>' +
        '<p class="ff-result__reassure">' + esc(REASSURANCE) + '</p>' +
        '<div class="ff-result__actions">' +
          (HAS_PRODUCT ? '<button type="button" class="ff-btn" data-ff-apply>Select ' + esc(SIZE_LABEL) + ' ' + esc(r.size) + '</button>' : '') +
          '<button type="button" class="ff-btn ff-btn--ghost" data-ff-restart>Start over</button>' +
        '</div>' +
      '</div>';

    try { sessionStorage.setItem(STORE_KEY, r.size); } catch (e) {}

    var applyBtn = body.querySelector('[data-ff-apply]');
    if (applyBtn) {
      applyBtn.addEventListener('click', function () { applySize(r.size); close(); });
    }
    body.querySelector('[data-ff-restart]').addEventListener('click', function () {
      step = 0; answers = {}; renderStep();
    });

    step = QUESTIONS.length;
    paint();
    body.focus();
  }

  function paint() {
    var total = QUESTIONS.length;
    var done = Math.min(step, total);
    bar.style.width = Math.round((done / total) * 100) + '%';
    backBtn.hidden = step === 0;
    stepEl.textContent = step < total ? 'Question ' + (step + 1) + ' of ' + total : 'Done';
  }

  backBtn.addEventListener('click', function () {
    if (step === 0) return;
    step--;
    renderStep();
  });

  /* ------------------- select the size on the product page ------------- */

  function applySize(value) {
    var scope = document.getElementById(SCOPE_ID) || document;
    var target = String(value).trim().toLowerCase();

    var radios = scope.querySelectorAll('input[type="radio"]');
    for (var i = 0; i < radios.length; i++) {
      if (String(radios[i].value).trim().toLowerCase() !== target) continue;
      if (radios[i].checked) return true;
      var label = radios[i].id ? scope.querySelector('label[for="' + radios[i].id + '"]') : null;
      if (label) { label.click(); } else {
        radios[i].checked = true;
        radios[i].dispatchEvent(new Event('change', { bubbles: true }));
      }
      return true;
    }

    var selects = scope.querySelectorAll('select');
    for (var s = 0; s < selects.length; s++) {
      var opts = selects[s].options;
      for (var o = 0; o < opts.length; o++) {
        if (String(opts[o].value).trim().toLowerCase() !== target) continue;
        selects[s].selectedIndex = o;
        selects[s].dispatchEvent(new Event('change', { bubbles: true }));
        return true;
      }
    }
    return false;
  }

  /* ------------------------------ modal ------------------------------- */

  function open(trigger) {
    lastFocused = trigger || document.activeElement;
    root.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function () { root.classList.add('is-open'); });
    if (step >= QUESTIONS.length) { step = 0; answers = {}; }
    renderStep();
  }

  function close() {
    root.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
    window.setTimeout(function () { root.hidden = true; }, 180);
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }

  root.addEventListener('click', function (e) {
    if (e.target === root) close();
    if (e.target.closest('[data-ff-close]')) close();
  });

  document.addEventListener('keydown', function (e) {
    if (root.hidden) return;
    if (e.key === 'Escape') { close(); return; }
    if (e.key !== 'Tab') return;

    var f = sheet.querySelectorAll('button:not([hidden]):not([disabled]), [href], input:not([disabled]), select, [tabindex]:not([tabindex="-1"])');
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-ff-open]');
    if (!t) return;
    e.preventDefault();
    open(t);
  });

  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
})();
</script>
{%- endif -%}

